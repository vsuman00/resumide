  apt-get -o APT::Get::AutomaticRemove=false --assume-yes --no-install-recommends purge -- $purge_packages;     for package in gpg gpgconf libgpgme11t64 libgpgmepp6t64 libpoppler147 poppler-utils; do       [ "$(dpkg-query -W -f='${db:Status-Status}' "$package")" = installed ] || exit 1;     done;     apt-get check;     rm -f /tmp/latex-purge-plan /tmp/latex-purge-expected /tmp/latex-purge-actual;     rm -f /tmp/pinned-font-uri
