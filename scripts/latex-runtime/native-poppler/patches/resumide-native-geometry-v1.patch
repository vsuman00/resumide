+static void printResumideBBox(FILE *f, PDFDoc *doc, TextOutputDev *textOut, int first, int last)
+{
+    static const char hex[] = "0123456789abcdef";
+    int completedPages = 0;
+    fputs("RESUMIDE_BBOX\t1\n", f);
+    for (int page = first; page <= last; ++page) {
+        const double wid = useCropBox ? doc->getPageCropWidth(page) : doc->getPageMediaWidth(page);
+        const double hgt = useCropBox ? doc->getPageCropHeight(page) : doc->getPageMediaHeight(page);
+        fprintf(f, "P\t%f\t%f\n", wid, hgt);
+        doc->displayPage(textOut, page, resolution, resolution, 0, !useCropBox, useCropBox, false);
+        std::unique_ptr<TextWordList> wordlist = textOut->makeWordList();
+        const int wordLength = wordlist != nullptr ? wordlist->getLength() : 0;
+        for (int i = 0; i < wordLength; ++i) {
+            TextWord *word = wordlist->get(i);
+            double xMin, yMin, xMax, yMax;
+            word->getBBox(&xMin, &yMin, &xMax, &yMax);
+            fprintf(f, "W\t%f\t%f\t%f\t%f\t", xMin, yMin, xMax, yMax);
+            std::unique_ptr<GooString> wordText(word->getText());
+            for (int j = 0; j < wordText->getLength(); ++j) {
+                const unsigned char byte = static_cast<unsigned char>(wordText->c_str()[j]);
+                fputc(hex[byte >> 4], f);
+                fputc(hex[byte & 15], f);
+            }
+            fputc('\n', f);
+        }
+        fputs("E\n", f);
+        ++completedPages;
+    }
+    fprintf(f, "Z\t%d\n", completedPages);
+}
