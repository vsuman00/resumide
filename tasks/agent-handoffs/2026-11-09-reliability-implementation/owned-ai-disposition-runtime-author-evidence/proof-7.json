+import { z } from "zod";
+import { runProviderAttempt } from "./provider-attempt";
+
+const id = z.uuid().regex(/^[a-f0-9-]+$/u);
+const sha = z.string().regex(/^[a-f0-9]{64}$/u);
+const stamp = z.iso
+  .datetime()
+  .regex(/^(?!0000)\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,6})?Z$/u);
+const MAX_ROWS = 4096;
+const MAX_BYTES = 32 * 1024 * 1024;
+const RETENTION_MICROSECONDS = 720n * 60n * 60n * 1_000_000n;
+
+export const OwnedAiDispositionProfileSchema = z.strictObject({
+  schemaVersion: z.literal("owned-ai-disposition-readiness/1.0.0"),
+  profileVersion: z.literal("owned-ai-disposition-profile/1.0.0"),
+  checkerSha256: sha,
+  exportSha256: sha,
+  accessSha256: sha,
+  metadataSha256: sha,
+});
+export type OwnedAiDispositionProfile = z.infer<
+  typeof OwnedAiDispositionProfileSchema
+>;
+export const OwnedAiDispositionReadinessSchema =
+  OwnedAiDispositionProfileSchema.extend({
+    schemaReady: z.boolean(),
+    exportExecutable: z.boolean(),
+    accessExecutable: z.boolean(),
+  });
+const account = z.strictObject({
+  owner_id: id,
+  first_request_id: id,
+  prepared_at: stamp,
+  expires_at: stamp,
+  phase: z.literal("prepared"),
+});
+const operation = z.strictObject({
+  kind: z.enum(["r03", "a12", "a13"]),
+  owner_id: id,
+  organization_id: id,
+  operation_id: id,
+  analysis_id: id.nullable(),
+  resume_id: id.nullable(),
+  resume_version_id: id.nullable(),
+  source_scope: z.enum([
+    "account_only",
+    "resume_root",
+    "historical_unresolved",
+  ]),
+  phase: z.enum(["prepared", "repair_required"]),
+  first_cause: z.enum(["account_preparation", "resume_retirement"]).nullable(),
+  deletion_request_id: id.nullable(),
+  retention_item_id: id.nullable(),
+  prepared_at: stamp.nullable(),
+  expires_at: stamp.nullable(),
+  effective_expires_at: stamp.nullable(),
+});
+const envelope = z.strictObject({
+  schemaVersion: z.literal("owned-ai-disposition-export/1.0.0"),
+  ownerId: id,
+  accounts: z.array(account).max(1),
+  operations: z.array(operation).max(MAX_ROWS),
+});
+export type OwnedAiDispositionExport = z.infer<typeof envelope>;
+export class OwnedAiDispositionExportError extends Error {
+  readonly code = "unavailable";
+  constructor() {
+    super("Owned AI disposition export is unavailable.");
+    this.name = "OwnedAiDispositionExportError";
+  }
+}
+const unavailable = () => new OwnedAiDispositionExportError();
+const fail: () => never = () => {
+  throw unavailable();
+};
+
+// Validate the raw JSON domain before schema traversal or JSON serialization.
+function bounded(raw: unknown) {
+  const work = [{ value: raw, depth: 0 }];
+  let bytes = 0,
+    visits = 0;
+  while (work.length) {
+    const { value, depth } = work.pop()!;
+    if (++visits > 100000 || depth > 8) fail();
+    if (typeof value === "string") {
+      if (
+        value.length > MAX_BYTES ||
+        value.includes("\0") ||
+        /[\uD800-\uDFFF]/u.test(value)
+      )
+        fail();
+      bytes += Buffer.byteLength(JSON.stringify(value), "utf8");
+    } else if (value === null || typeof value === "boolean") bytes += 5;
+    else if (Array.isArray(value)) {
+      if (value.length > MAX_ROWS) fail();
+      const descriptors = Object.getOwnPropertyDescriptors(value);
+      if (
+        Object.getPrototypeOf(value) !== Array.prototype ||
+        Reflect.ownKeys(value).length !== value.length + 1
+      )
+        fail();
+      bytes += value.length + 2;
+      for (let index = 0; index < value.length; index++) {
+        const descriptor = descriptors[String(index)];
+        if (
+          !descriptor ||
+          descriptor.get ||
+          descriptor.set ||
+          !descriptor.enumerable
+        )
+          fail();
+        work.push({ value: descriptor.value, depth: depth + 1 });
+      }
+    } else if (typeof value === "object" && value !== null) {
+      const proto = Object.getPrototypeOf(value);
+      const descriptors = Object.getOwnPropertyDescriptors(value);
+      if (
+        (proto !== Object.prototype && proto !== null) ||
+        Reflect.ownKeys(value).length !== Object.keys(descriptors).length
+      )
+        fail();
+      bytes += 2;
+      for (const [key, descriptor] of Object.entries(descriptors)) {
+        if (
+          descriptor.get ||
+          descriptor.set ||
+          !descriptor.enumerable ||
+          key.includes("\0") ||
+          /[\uD800-\uDFFF]/u.test(key)
+        )
+          fail();
+        bytes += Buffer.byteLength(JSON.stringify(key), "utf8") + 2;
+        work.push({ value: descriptor.value, depth: depth + 1 });
+      }
+    } else fail();
+    if (bytes > MAX_BYTES) fail();
+  }
+}
+// Date parses only whole UTC seconds; fractional microseconds stay exact.
+function micros(value: string): bigint {
+  const fraction = /(?:\.(\d{1,6}))?Z$/u.exec(value)?.[1] ?? "";
+  return (
+    BigInt(Date.parse(`${value.slice(0, 19)}Z`)) * 1000n +
+    BigInt(fraction.padEnd(6, "0"))
+  );
+}
+export function validateOwnedAiDispositionExport(
+  raw: unknown,
+  ownerId: string,
+): OwnedAiDispositionExport {
+  try {
+    if (!id.safeParse(ownerId).success) fail();
+    bounded(raw);
+    const data = envelope.parse(raw);
+    if (
+      data.ownerId !== ownerId ||
+      data.accounts.length + data.operations.length > MAX_ROWS
+    )
+      fail();
+    const accountRow = data.accounts[0];
+    if (
+      accountRow &&
+      (accountRow.owner_id !== ownerId ||
+        micros(accountRow.expires_at) - micros(accountRow.prepared_at) !==
+          RETENTION_MICROSECONDS)
+    )
+      fail();
+    const seen = new Set<string>();
+    for (const row of data.operations) {
+      const identity = JSON.stringify([
+        row.kind,
+        row.owner_id,
+        row.analysis_id,
+        row.operation_id,
+      ]);
+      if (row.owner_id !== ownerId || seen.has(identity)) fail();
+      seen.add(identity);
+      if (row.kind !== "r03" && row.analysis_id === null) fail();
+      if (row.phase === "repair_required") {
+        if (
+          row.source_scope !== "historical_unresolved" ||
+          row.first_cause !== null ||
+          row.deletion_request_id !== null ||
+          row.retention_item_id !== null ||
+          row.prepared_at !== null ||
+          row.expires_at !== null ||
+          row.effective_expires_at !== null
+        )
+          fail();
+        continue;
+      }
+      if (
+        row.source_scope === "historical_unresolved" ||
+        row.prepared_at === null ||
+        row.expires_at === null ||
+        row.effective_expires_at === null ||
+        row.first_cause === null
+      )
+        fail();
+      if (row.source_scope === "account_only") {
+        if (
+          row.kind !== "r03" ||
+          row.analysis_id !== null ||
+          row.resume_id !== null ||
+          row.resume_version_id !== null ||
+          row.first_cause !== "account_preparation"
+        )
+          fail();
+      } else if (
+        row.analysis_id === null ||
+        row.resume_id === null ||
+        row.resume_version_id === null
+      )
+        fail();
+      const ownExpiry = micros(row.expires_at);
+      if (ownExpiry - micros(row.prepared_at) !== RETENTION_MICROSECONDS)
+        fail();
+      const accountExpiry = accountRow
+        ? micros(accountRow.expires_at)
+        : ownExpiry;
+      if (
+        micros(row.effective_expires_at) !==
+        (accountExpiry < ownExpiry ? accountExpiry : ownExpiry)
+      )
+        fail();
+      if (row.first_cause === "account_preparation") {
+        if (
+          !accountRow ||
+          row.deletion_request_id !== accountRow.first_request_id ||
+          row.retention_item_id !== null ||
+          micros(row.prepared_at) !== micros(accountRow.prepared_at)
+        )
+          fail();
+      } else if (
+        row.retention_item_id === null ||
+        row.deletion_request_id !== null
+      )
+        fail();
+    }
+    return data;
+  } catch {
+    throw unavailable();
+  }
+}
+/** Shape parsing never supplies Native completeness or erasure authority. */
+export const OwnedAiDispositionExportSchema = z.preprocess((raw, ctx) => {
+  try {
+    bounded(raw);
+    return raw;
+  } catch {
+    ctx.addIssue({
+      code: "custom",
+      message: "Disposition export is unavailable.",
+    });
+    return z.NEVER;
+  }
+}, envelope);
+
+type Reply = { data: unknown; error: unknown };
+export interface OwnedAiDispositionExportClient {
+  rpc(
+    name: string,
+    args: Record<string, unknown>,
+  ): PromiseLike<Reply> & {
+    abortSignal?: (signal: AbortSignal) => PromiseLike<Reply>;
+  };
+}
+/** Fresh bounded metadata/data reads; no implicit pins, cache, retry or fallback. */
+export async function readOwnedAiDispositionExport(
+  client: OwnedAiDispositionExportClient,
+  ownerId: string,
+  expectedProfile: OwnedAiDispositionProfile,
+  options: {
+    signal?: AbortSignal;
+    timeoutMs?: number;
+    now?: () => number;
+  } = {},
+): Promise<OwnedAiDispositionExport> {
+  try {
+    const profile = OwnedAiDispositionProfileSchema.parse(expectedProfile);
+    const timeoutMs = options.timeoutMs ?? 5000,
+      now = options.now ?? Date.now;
+    if (
+      !id.safeParse(ownerId).success ||
+      !client ||
+      typeof client.rpc !== "function" ||
+      !Number.isSafeInteger(timeoutMs) ||
+      timeoutMs < 1 ||
+      timeoutMs > 5000 ||
+      typeof now !== "function"
+    )
+      fail();
+    const started = now();
+    if (!Number.isFinite(started)) fail();
+    const active = () => {
+      const at = now();
+      if (!Number.isFinite(at) || at < started || at - started >= timeoutMs)
+        fail();
+    };
+    return await runProviderAttempt({
+      timeoutMs,
+      signal: options.signal,
+      failure: unavailable,
+      execute: async (signal) => {
+        const call = async (name: string, args: Record<string, unknown>) => {
+          active();
+          if (signal.aborted) fail();
+          const pending = client.rpc(name, args);
+          const reply = await (typeof pending.abortSignal === "function"
+            ? pending.abortSignal(signal)
+            : pending);
+          active();
+          if (signal.aborted || !reply || reply.error) fail();
+          return reply.data;
+        };
+        const rawReady = await call("read_owned_ai_disposition_readiness", {});
+        bounded(rawReady);
+        const ready = OwnedAiDispositionReadinessSchema.parse(rawReady);
+        if (
+          !ready.schemaReady ||
+          !ready.exportExecutable ||
+          Object.entries(profile).some(
+            ([key, value]) => ready[key as keyof typeof ready] !== value,
+          )
+        )
+          fail();
+        const data = validateOwnedAiDispositionExport(
+          await call("export_owned_ai_disposition_records", {
+            p_user_id: ownerId,
+          }),
+          ownerId,
+        );
+        active();
+        if (signal.aborted) fail();
+        return data;
+      },
+    });
+  } catch {
+    throw unavailable();
+  }
+}
