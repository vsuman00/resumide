+const id = (n: number) =>
+  `c0000000-0000-4000-8000-${String(n).padStart(12, "0")}`;
+const before = "2026-10-15T00:00:00.000Z";
+const now = new Date("2026-11-15T00:00:00Z");
+const ready = () => ({
+  ...OWNED_AI_DISPOSITION_PROFILE,
+  schemaReady: true,
+  exportExecutable: false,
+  accessExecutable: false,
+});
+const row = (n = 1, root = 2) => ({
+  item_id: id(n),
+  resume_id: id(root),
+  storage_key: createResumeStorageKey({
+    organizationId: id(3),
+    resumeId: id(root),
+    versionId: id(n + 100),
+  }),
+});
+type Reply = { data: unknown; error: unknown };
+function query(reply: Reply | Promise<Reply>, ignoreAbort = false) {
+  const pending = Promise.resolve(reply),
+    aborted = vi.fn();
+  return Object.assign(pending, {
+    aborted,
+    abortSignal: vi.fn((signal: AbortSignal) => {
+      if (ignoreAbort) return pending;
+      return new Promise<Reply>((resolve, reject) => {
+        const abort = () => {
+          aborted();
+          reject(new Error("PRIVATE_ABORT"));
+        };
+        if (signal.aborted) abort();
+        else signal.addEventListener("abort", abort, { once: true });
+        void pending.then(
+          (value) => {
+            signal.removeEventListener("abort", abort);
+            resolve(value);
+          },
+          (error) => {
+            signal.removeEventListener("abort", abort);
+            reject(error);
+          },
+        );
+      });
+    }),
+  });
+}
+function fixture(overrides: Record<string, unknown> = {}) {
