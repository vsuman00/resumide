o service_oid from pg_catalog.pg_roles where rolname='service_role';\n select proowner into owner_oid from pg_catalog.pg_proc where oid=to_regprocedure('public.persist_deterministic_analysis(uuid,text,jsonb,text,jsonb,text,text,text,text,jsonb,text,integer,text)');\n if service_oid is null or owner_oid is null then return false;end if;\n for item in select value from jsonb_array_elements(manifest) loop\n  select * into p from pg_catalog.pg_proc where oid=to_regprocedure(item->>'signature');\n  if not found or p.proowner<>owner_oid or p.prokind<>'f' or p.proretset is distinct from (item->>'setof')::boolean\n    or p.proisstrict or p.prosecdef is distinct from (item->>'definer')::boolean or p.provolatile<>item->>'volatility'\n    or p.prorettype<>to_regtype(item->>'resultType') or p.prolang<>(select oid from pg_catalog.pg_language where lanname=item->>'language')\n    or p.proconfig is distinct from array['search_path=\"\"'] or private.ifo_sha(p.prosrc)<>item->>'sha256' then return false;end if;\n  if exists(select 1 from aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) g where g.grantee<>p.proowner\n    and (item->>'acl'='private' or g.grantee<>service_oid or g.privilege_type<>'EXECUTE' or g.is_grantable)) then return false;end if;\n  foreach role_name in array array['anon','authenticated'] loop if has_function_privilege(role_name,p.oid,'EXECUTE') then return false;end if;end loop;\n  if item->>'acl'='private' and has_function_privilege('service_role',p.oid,'EXECUTE') then return false;end if;\n  if item->>'acl' in ('metadata','service') and not has_function_privilege('service_role',p.oid,'EXECUTE') then return false;end if;\n end loop;\n foreach table_name in array array['owned_ai_deletion_dispositions','owned_ai_operation_dispositions'] loop\n  select * into rel from pg_catalog.pg_class where oid=to_regclass('private.'||table_name);\n  if not found or rel.relkind<>'r' or rel.relowner<>owner_oid or not rel.relrowsecurity or rel.relforcerowsecurity\n    or exists(select 1 from pg_catalog.pg_policy where polrelid=rel.oid)\n    or exists(select 1 from pg_catalog.pg_constraint where conrelid=rel.oid and contype='f')\n    or exists(select 1 from aclexplode(coalesce(rel.relacl,acldefault('r',rel.relowner))) g where g.grantee<>rel.relowner)\n    then return false;end if;\n  foreach role_name in array array['anon','authenticated','service_role'] loop\n   if has_table_privilege(role_name,rel.oid,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER')\n    or has_any_column_privilege(role_name,rel.oid,'SELECT,INSERT,UPDATE,REFERENCES') then return false;end if;\n  end loop;\n  expected:=case when table_name='owned_ai_deletion_dispositions' then 5 else 14 end;\n  if (select count(*) from pg_catalog.pg_attribute where attrelid=rel.oid and attnum>0 and not attisdropped)<>expected\n    or exists(select 1 from pg_catalog.pg_attribute where attrelid=rel.oid and attnum>0 and not attisdropped and atthasdef)\n    then return false;end if;\n  for item in select value from jsonb_array_elements(($disposition_columns${\"owned_ai_deletion_dispositions\":[[\"owner_id\",\"uuid\",true],[\"first_request_id\",\"uuid\",true],[\"prepared_at\",\"timestamp with time zone\",true],[\"expires_at\",\"timestamp with time zone\",true],[\"phase\",\"text\",true]],\"owned_ai_operation_dispositions\":[[\"kind\",\"text\",true],[\"owner_id\",\"uuid\",true],[\"organization_id\",\"uuid\",true],[\"operation_id\",\"uuid\",true],[\"analysis_id\",\"uuid\",false],[\"resume_id\",\"uuid\",false],[\"resume_version_id\",\"uuid\",false],[\"source_scope\",\"text\",true],[\"phase\",\"text\",true],[\"first_cause\",\"text\",false],[\"deletion_request_id\",\"uuid\",false],[\"retention_item_id\",\"uuid\",false],[\"prepared_at\",\"timestamp with time zone\",false],[\"expires_at\",\"timestamp with time zone\",false]]}$disposition_columns$::jsonb)->table_name) loop\n   if not exists(select 1 from pg_catalog.pg_attribute a where a.attrelid=rel.oid and a.attnum>0 and not a.attisdro