rId',p_user_id,'accounts',to_jsonb(accounts),'operations',to_jsonb(operations));\n if octet_length(convert_to(answer::text,'UTF8'))>33554432 then raise exception 'OWNED_AI_DISPOSITION_LIMIT' using errcode='23514';end if;\n return answer;\nend;\n","setof":false},{"signature":"private.owned_ai_disposition_ready()","before":"54cf095454ae1c9b87afea2537606a01732d98d00b1e077d44c174b25cf7c718","after":"b20a83ce978794972816d2fd238999179921426d55ae77da1d35515f944370e0","old":"\ndeclare item jsonb;p pg_catalog.pg_proc%rowtype;owner_oid oid;service_oid oid;role_name text;rel pg_catalog.pg_class%rowtype;table_name text;expected integer;\n manifest jsonb:=$disposition_catalog$[{\"signature\":\"private.owned_ai_disposition_guard()\",\"sha256\":\"b489c10cedcdc457a444521019fee37375ed3236ebfe5a1eb749b280b1acaa56\",\"definer\":false,\"volatility\":\"v\",\"language\":\"plpgsql\",\"setof\":false,\"resultType\":\"trigger\",\"acl\":\"private\"},{\"signature\":\"private.capture_owned_ai_disposition_row(text,uuid,uuid,uuid,uuid,uuid,uuid,text,text,uuid,uuid,timestamp with time zone)\",\"sha256\":\"cf825c28b305219e2e3b6658760e9ea9a3641ea93b0b1d75576b8e607b15ff02\",\"definer\":false,\"volatility\":\"v\",\"language\":\"plpgsql\",\"setof\":false,\"resultType\":\"void\",\"acl\":\"private\"},{\"signature\":\"private.capture_owned_ai_operation_dispositions(uuid,uuid,uuid,uuid)\",\"sha256\":\"8216f15fbb8ace1933ac7a4b9f6d72f6d44e8cc27ceb7ff58d48cd605e5d7d15\",\"definer\":false,\"volatility\":\"v\",\"language\":\"plpgsql\",\"setof\":false,\"resultType\":\"void\",\"acl\":\"private\"},{\"signature\":\"public.read_candidate_privacy_access(uuid)\",\"sha256\":\"0846149a1f25edf14ea3c907219634cda85358065b3e4d5a06c79da2522f87db\",\"definer\":true,\"volatility\":\"v\",\"language\":\"plpgsql\",\"setof\":false,\"resultType\":\"jsonb\",\"acl\":\"optional_service\"},{\"signature\":\"public.export_owned_ai_disposition_records(uuid)\",\"sha256\":\"cc77dc66d2a576de1e5249ff1542188c06314cb703a10a6a41dbbf111bd011b5\",