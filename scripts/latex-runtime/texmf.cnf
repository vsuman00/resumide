TEXMF = /usr/share/texlive/texmf-dist
TEXMFROOT = /usr/share/texlive
TEXMFDIST = /usr/share/texlive/texmf-dist
TEXMFSYSVAR = /var/lib/texmf
TEXMFSYSCONFIG = /etc/texmf
TEXMFVAR = /scratch
TEXMFCONFIG = /scratch
TEXMFCACHE = /scratch
TEXINPUTS = .:/usr/share/texlive/texmf-dist/tex//
TEXFORMATS = /var/lib/texmf/web2c/xetex
TFMFONTS = /usr/share/texlive/texmf-dist/fonts/tfm//
VFFONTS = /usr/share/texlive/texmf-dist/fonts/vf//
T1FONTS = /usr/share/texlive/texmf-dist/fonts/type1//
TTFONTS = /usr/share/texlive/texmf-dist/fonts/truetype//
OPENTYPEFONTS = /usr/share/texmf/fonts/opentype//:/usr/share/texlive/texmf-dist/fonts/opentype//
TEXFONTMAPS = /var/lib/texmf/fonts/map//:/usr/share/texlive/texmf-dist/fonts/map//
ENCFONTS = /usr/share/texlive/texmf-dist/fonts/enc//
TEXPSHEADERS = /usr/share/texlive/texmf-dist/fonts//
DVIPDFMXINPUTS = /etc/texmf/dvipdfmx:/usr/share/texlive/texmf-dist/dvipdfmx
openin_any = p
openout_any = p
shell_escape = f
MKTEXPK = 0
MKTEXTFM = 0
MKTEXFMT = 0
MKTEXMF = 0
MKTEXOPT = 0

MISCFONTS = /usr/share/texlive/texmf-dist/fonts/misc//

% Fixed capacities for the shipped LaTeX format, still bounded by container memory.
main_memory = 5000000
extra_mem_top = 0
extra_mem_bot = 0
pool_size = 6250000
string_vacancies = 90000
pool_free = 47500
max_strings = 500000
font_mem_size = 8000000
font_max = 9000
trie_size = 1100000
hyph_size = 8191
buf_size = 200000
nest_size = 500
max_in_open = 15
param_size = 10000
save_size = 200000
stack_size = 10000
hash_extra = 600000
error_line = 79
half_error_line = 50
max_print_line = 79
