hAllowed' is distinct from 'true'::jsonb then\n      return jsonb_build_object('operation',private.canonical_rewrite_operation(op,false),'budget',budget); end if;\n  end if;\n  update private.canonical_rewrite_operations set state='dispatched',claimed_at=clock_timestamp()\n    where owner_id=p_user_id and analysis_id=p_analysis_id and operation_id=p_operation_id returning * into op;\n  return jsonb_build_object('operation',private.canonical_rewrite_operation(op,true),'budget',budget);\nend;\n","setof":false},{"signature":"public.claim_initial_feedback_dispatch(uuid,jsonb,uuid,uuid,text,jsonb)","before":"335cef3a4e4f948b4c3b3c17ea9a3159368cab5df6e5a7a1389bc0f46759766a","after":"8d9ca0645d4457616d6a7fc947658fa89b3b7529042ba6f17f90f1cbc051012a","old":"\ndeclare a public.analyses%rowtype;op private.initial_feedback_operations%rowtype;att private.initial_feedback_attempts%rowtype;\n  original jsonb;ctx jsonb;pol jsonb;budget jsonb:=null;req jsonb;\nbegin\n  if p_analysis_id is null or p_operation_id is null or p_attempt_id is null or p_binding_sha256 is null\n    or p_binding_sha256 collate \"C\" !~ '^[a-f0-9]{64}$' or private.legacy_scoring_lease(p_lease) is not true then perform private.ifo_fail('invalid');end if;\n  if private.initial_feedback_operation_ready() is not true then perform private.ifo_fail('unavailable');end if;\n  a:=private.legacy_scoring_access(p_analysis_id,null);original:=private.ifo_original(a);\n  select * into op from private.initial_feedback_operations where operation_id=p_operation_id and analysis_id=a.id\n    and owner_id=a.owner_id and organization_id=a.organization_id for update;\n  if not found or op.binding_sha256<>p_binding_sha256\n    or op.binding is distinct from private.ifo_binding(original,op.binding->'policy') then perform private.ifo_fail('not_found');end if;\n  select * into att from private.initial_feedback_attempts where attempt_id=p_attempt_id and operation_id=op.operation_id for update;\n  if not found then perform private.ifo_