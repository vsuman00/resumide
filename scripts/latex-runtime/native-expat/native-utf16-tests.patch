--- /dev/null
+++ b/tests/resumide_utf16_test.h
@@ -0,0 +1,25 @@
+/* Test-only C11 adapter for the unchanged Debian UTF-16/non-wchar ABI. */
+#ifndef RESUMIDE_UTF16_TEST_H
+#define RESUMIDE_UTF16_TEST_H
+#include <stdio.h>
+#include <uchar.h>
+_Static_assert(sizeof(XML_Char) == 2, "native XML_Char must remain UTF-16");
+_Static_assert(_Generic((char16_t *)0, XML_Char *: 1, default: 0),
+               "C11 UTF-16 literals must match the existing XML_Char type");
+/* ponytail: upstream tests are single-threaded; four buffers preserve printf argument independence. */
+static inline const char *resumide_utf16_diag(const XML_Char *value) {
+  static char buffers[4][256];
+  static unsigned slot;
+  char *output = buffers[slot++ % 4];
+  size_t used = 0;
+  if (value == NULL) return "(null)";
+  while (*value && used + 10 < 256) {
+    unsigned unit = *value++;
+    if (unit >= 32 && unit <= 126 && unit != 92) output[used++] = (char)unit;
+    else { snprintf(output + used, 256 - used, "\\u%04x", unit); used += 6; }
+  }
+  if (*value) { output[used++] = '.'; output[used++] = '.'; output[used++] = '.'; }
+  output[used] = 0;
+  return output;
+}
+#endif
